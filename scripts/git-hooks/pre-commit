#!/usr/bin/env bash
# Git pre-commit hook. Enable once per clone: git config core.hooksPath scripts/git-hooks
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/../common.sh"

# Lint shell scripts (as they are on disk) only if the commit touches them or the ShellCheck config.
if [[ -n $(git diff --cached --name-only -- scripts .shellcheckrc) ]]; then
    scripts/lint_scripts.sh
fi
